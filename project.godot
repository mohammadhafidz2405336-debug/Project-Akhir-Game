; Engine configuration file.
; Relational Data Chronicles: The Lost Schema — Kelompok 9
config_version=5

[application]

config/name="Relational Data Chronicles: The Lost Schema"
config/description="Action-puzzle platformer edukasi model data relasional (Kelompok 9)."
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/sprites/ui/icon.png"
boot_splash/show_image=false

[autoload]

EventBus="*res://autoload/event_bus.gd"
GameState="*res://autoload/game_state.gd"
SaveManager="*res://autoload/save_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"
SkillManager="*res://autoload/skill_manager.gd"
MarketManager="*res://autoload/market_manager.gd"
RoomManager="*res://autoload/room_manager.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

